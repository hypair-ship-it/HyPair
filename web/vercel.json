{
  "cleanUrls": true,
  "redirects": [
    { "source": "/:l([a-z0-9])", "destination": "/?utm_source=heycatch&utm_campaign=:l", "permanent": false },
    { "source": "/tryka-dublin", "destination": "/", "permanent": true },
    { "source": "/hyrox-dublin", "destination": "/", "permanent": true },
    { "source": "/hyrox-doubles-partner", "destination": "/", "permanent": true },
    { "source": "/events", "destination": "/", "permanent": true },
    { "source": "/event/:id/:rest+", "destination": "/invite", "permanent": false },
    { "source": "/athlete/:id*", "destination": "/?ref=invite", "permanent": false }
  ],
  "rewrites": [
    { "source": "/event/:id", "destination": "/api/event/:id" }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/app-version.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, must-revalidate" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://va.vercel-scripts.com https://esm.sh https://in.heycatch.ai; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://lsxprzoxoarfakhxhoab.supabase.co; connect-src 'self' https://lsxprzoxoarfakhxhoab.supabase.co https://va.vercel-scripts.com https://in.heycatch.ai; report-uri /api/csp-report; report-to csp-endpoint;" },
        { "key": "Reporting-Endpoints", "value": "csp-endpoint=\"/api/csp-report\"" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
