{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://llkdujodseyilzbkzdbf.supabase.co https://va.vercel-scripts.com;" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/for-gyms", "destination": "/site/for-gyms" },
    { "source": "/hyrox-dublin", "destination": "/site/hyrox-dublin" },
    { "source": "/tryka-dublin", "destination": "/site/tryka-dublin" },
    { "source": "/hyrox-doubles-partner", "destination": "/site/hyrox-doubles-partner" },
    { "source": "/terms", "destination": "/site/terms" },
    { "source": "/privacy", "destination": "/site/privacy" },
    { "source": "/cookies", "destination": "/site/cookies" }
  ]
}
